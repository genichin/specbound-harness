{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecBound delivery-QC v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requirement", "coverage", "regression_evidence", "authority", "residual_risk", "verdict"],
  "properties": {
    "schema_version": {"const": 1},
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "id", "revision", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^\\.specbound/requirements/req-[0-9]+/req-[0-9]+-r[1-9][0-9]*\\.md$"},
        "id": {"type": "string", "pattern": "^req-[0-9]+$"},
        "revision": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptance_criterion", "iteration_qc"],
        "properties": {
          "acceptance_criterion": {"type": "string", "pattern": "^AC-[0-9]+$"},
          "iteration_qc": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "pattern": "^\\.specbound/iteration-qc/req-[0-9]+/iqc-[0-9]+-0*[1-9][0-9]*-r[1-9][0-9]*\\.json$"},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    "regression_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result", "exit_code"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "result": {"enum": ["passed", "failed"]},
          "exit_code": {"type": "integer"}
        }
      }
    },
    "authority": {"type": "string", "minLength": 1},
    "residual_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unresolved_exceptions", "disposition"],
      "properties": {
        "unresolved_exceptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "disposition": {"type": "string", "minLength": 1}
      }
    },
    "verdict": {"enum": ["verified", "rework", "blocked"]}
  }
}
