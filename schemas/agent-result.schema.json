{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specbound.local/schemas/agent-result.schema.json",
  "title": "SpecBound provider-neutral agent result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "role_id", "task_kind", "target",
    "producer_result_ref", "reviewer_run_ref", "artifacts", "evidence",
    "provenance", "verification", "verdict", "permitted_next_action", "claims"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "role_id": {"enum": ["discovery-author", "requirement-author", "micro-spec-author", "independent-reviewer", "implementation", "iteration-qc", "delivery-qc"]},
    "task_kind": {"enum": ["discovery-author", "requirement-author", "micro-spec-author", "independent-reviewer", "implementation", "iteration-qc", "delivery-qc"]},
    "target": {"$ref": "#/$defs/boundArtifact"},
    "producer_result_ref": {"$ref": "#/$defs/nullableReference"},
    "reviewer_run_ref": {"$ref": "#/$defs/nullableReference"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "kind"],
        "properties": {
          "path": {"$ref": "#/$defs/safePath"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "kind": {"enum": ["candidate", "implementation", "review", "evidence"]}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "status", "artifact_ref", "detail"],
        "properties": {
          "slot": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "status": {"enum": ["provided", "not_applicable"]},
          "artifact_ref": {"$ref": "#/$defs/nullableReference"},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_id", "request_sha256", "tool_categories", "mutation_classes"],
      "properties": {
        "execution_id": {"type": "string", "minLength": 1},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "tool_categories": {"type": "array", "uniqueItems": true, "items": {"enum": ["repository-read", "candidate-write", "test-execute", "filesystem-metadata"]}},
        "mutation_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["none", "candidate_write", "repository_mutation", "evidence_write"]}}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "summary"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "result", "exit_code"],
            "properties": {
              "command": {"type": "string", "minLength": 1},
              "result": {"enum": ["passed", "failed", "not_run"]},
              "exit_code": {"type": ["integer", "null"]}
            }
          }
        },
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "verdict": {"enum": ["completed", "rework", "blocked"]},
    "permitted_next_action": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "claims": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "nullableReference": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "boundArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
