{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpecBound Discovery confirmation record (bootstrap slice)",
  "type": "object",
  "required": [
    "schema_version",
    "discovery_path",
    "discovery_id",
    "revision",
    "sha256",
    "risk_class",
    "authority",
    "confirmed_at",
    "decision",
    "permitted_next_action"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "discovery_path": {"type": "string", "pattern": "^docs/discoveries/dcy-[0-9]+/disc-[0-9]+-r[1-9][0-9]*\\.md$"},
    "discovery_id": {"type": "string", "pattern": "^disc-[0-9]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "risk_class": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "confirmed_at": {"type": "string", "format": "date-time"},
    "decision": {"const": "confirmed"},
    "permitted_next_action": {"const": "draft_req_only"}
  },
  "additionalProperties": true
}
