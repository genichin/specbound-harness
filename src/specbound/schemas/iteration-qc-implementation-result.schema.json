{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "minLength": 1,
      "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
      "type": "string"
    },
    "actor": {
      "minLength": 1,
      "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
      "type": "string"
    },
    "context_id": {
      "minLength": 1,
      "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
      "type": "string"
    },
    "micro_spec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^ms-[0-9]+-0*[1-9][0-9]*$",
          "type": "string"
        },
        "path": {
          "pattern": "^\\.specbound/micro-specs/req-[0-9]+/ms-[0-9]+-0*[1-9][0-9]*\\.md$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "id",
        "sha256"
      ],
      "type": "object"
    },
    "result_id": {
      "minLength": 1,
      "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "selected_acceptance_criteria": {
      "items": {
        "pattern": "^AC-[0-9]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "source_commit": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "verdict": {
      "const": "pass"
    },
    "verification": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "acceptance_criterion": {
            "pattern": "^AC-[0-9]+$",
            "type": "string"
          },
          "command": {
            "minLength": 1,
            "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
            "type": "string"
          },
          "exit_code": {
            "const": 0
          },
          "result": {
            "const": "passed"
          }
        },
        "required": [
          "acceptance_criterion",
          "command",
          "result",
          "exit_code"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "result_id",
    "micro_spec",
    "source_commit",
    "actor",
    "action_id",
    "context_id",
    "selected_acceptance_criteria",
    "verification",
    "verdict"
  ],
  "title": "SpecBound iteration-QC implementation result v1",
  "type": "object"
}
