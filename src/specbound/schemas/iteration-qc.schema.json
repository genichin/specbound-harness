{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "adoption": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "pattern": "^\\.specbound/adoptions/req-[0-9]+/adp-[0-9]+-r[1-9][0-9]*-iteration_qc\\.json$",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "transition": {
              "const": "iteration_qc"
            }
          },
          "required": [
            "path",
            "sha256",
            "transition"
          ],
          "type": "object"
        },
        "authority": {
          "additionalProperties": false,
          "properties": {
            "authority_action_id": {
              "minLength": 1,
              "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
              "type": "string"
            },
            "context_id": {
              "minLength": 1,
              "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
              "type": "string"
            },
            "identity": {
              "minLength": 1,
              "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
              "type": "string"
            }
          },
          "required": [
            "identity",
            "authority_action_id",
            "context_id"
          ],
          "type": "object"
        },
        "decided_at": {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        "evaluation_result": {
          "additionalProperties": false,
          "properties": {
            "action_id": {
              "minLength": 1,
              "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
              "type": "string"
            },
            "context_id": {
              "minLength": 1,
              "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
              "type": "string"
            },
            "evaluator": {
              "minLength": 1,
              "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
              "type": "string"
            },
            "implementation_result_id": {
              "minLength": 1,
              "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
              "type": "string"
            },
            "implementation_result_sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "result_id": {
              "minLength": 1,
              "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "result_id",
            "sha256",
            "implementation_result_id",
            "implementation_result_sha256",
            "evaluator",
            "action_id",
            "context_id"
          ],
          "type": "object"
        },
        "implementation_result": {
          "additionalProperties": false,
          "properties": {
            "action_id": {
              "minLength": 1,
              "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
              "type": "string"
            },
            "actor": {
              "minLength": 1,
              "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
              "type": "string"
            },
            "context_id": {
              "minLength": 1,
              "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
              "type": "string"
            },
            "result_id": {
              "minLength": 1,
              "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "source_commit": {
              "pattern": "^[a-f0-9]{40}$",
              "type": "string"
            }
          },
          "required": [
            "result_id",
            "sha256",
            "source_commit",
            "actor",
            "action_id",
            "context_id"
          ],
          "type": "object"
        },
        "micro_spec": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "pattern": "^ms-[0-9]+-0*[1-9][0-9]*$",
              "type": "string"
            },
            "path": {
              "pattern": "^\\.specbound/micro-specs/req-[0-9]+/ms-[0-9]+-0*[1-9][0-9]*\\.md$",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "id",
            "sha256"
          ],
          "type": "object"
        },
        "micro_spec_review": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "pattern": "^\\.specbound/micro-spec-reviews/req-[0-9]+/ms-[0-9]+-0*[1-9][0-9]*\\.review\\.json$",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "type": "object"
        },
        "policy": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "const": "specbound.yaml"
            },
            "selector": {
              "const": "iteration_qc_authorities_by_risk"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "sha256",
            "selector"
          ],
          "type": "object"
        },
        "remaining_acceptance_criteria": {
          "items": {
            "pattern": "^AC-[0-9]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "requirement": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "pattern": "^req-[0-9]+$",
              "type": "string"
            },
            "path": {
              "pattern": "^\\.specbound/requirements/req-[0-9]+/req-[0-9]+-r[1-9][0-9]*\\.md$",
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "id",
            "revision",
            "sha256"
          ],
          "type": "object"
        },
        "schema_version": {
          "const": 1
        },
        "selected_acceptance_criteria": {
          "items": {
            "pattern": "^AC-[0-9]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "verdict": {
          "const": "verified"
        },
        "verification": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "command": {
                "minLength": 1,
                "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
                "type": "string"
              },
              "exit_code": {
                "const": 0
              },
              "result": {
                "const": "passed"
              }
            },
            "required": [
              "command",
              "result",
              "exit_code"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "requirement",
        "adoption",
        "micro_spec",
        "micro_spec_review",
        "selected_acceptance_criteria",
        "implementation_result",
        "evaluation_result",
        "authority",
        "policy",
        "verification",
        "verdict",
        "remaining_acceptance_criteria",
        "decided_at"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "micro_spec": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "pattern": "^ms-[0-9]+-0*[1-9][0-9]*$",
              "type": "string"
            },
            "path": {
              "pattern": "^\\.specbound/micro-specs/req-[0-9]+/ms-[0-9]+-0*[1-9][0-9]*\\.md$",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "id",
            "sha256"
          ],
          "type": "object"
        },
        "remaining_acceptance_criteria": {
          "items": {
            "pattern": "^AC-[0-9]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "schema_version": {
          "const": 1
        },
        "selected_acceptance_criteria": {
          "items": {
            "pattern": "^AC-[0-9]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "verdict": {
          "enum": [
            "verified",
            "rework",
            "blocked"
          ]
        },
        "verification": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "command": {
                "minLength": 1,
                "pattern": "^(?=.*\\S)(?!.*(?:<[^>]+>|[Tt][Oo][Dd][Oo]|[Tt][Bb][Dd]|[Pp][Ll][Aa][Cc][Ee][Hh][Oo][Ll][Dd][Ee][Rr])).+$",
                "type": "string"
              },
              "exit_code": {
                "type": "integer"
              },
              "result": {
                "enum": [
                  "passed",
                  "failed"
                ]
              }
            },
            "required": [
              "command",
              "result",
              "exit_code"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "micro_spec",
        "selected_acceptance_criteria",
        "verification",
        "verdict",
        "remaining_acceptance_criteria"
      ],
      "type": "object"
    }
  ],
  "title": "SpecBound iteration-QC v1 authority-bound and legacy compatibility profiles"
}
